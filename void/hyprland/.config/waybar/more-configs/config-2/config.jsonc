//-*- mode: jsonc -*-
// Waybar config — Tokyo Night theme
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    // Floating bar margins (couple with border-radius in style.css)
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": [
        "hyprland/workspaces",
        "custom/sep",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/sep",
        "wireplumber",
        "backlight",
        "custom/sep",
        "temperature",
        "cpu",
        "memory",
        "disk",
        "custom/sep",
        "battery",
        "custom/sep",
        "tray"
    ],

    // ------------------------------------------------------------
    // Module configuration
    // ------------------------------------------------------------
    "hyprland/workspaces": {
        "disable-scroll": true,
        "sort-by-number": true,
        "format": "{name}",
        "tooltip-format": "Workspace {name}",
        "persistent-workspaces": {
            "*": 9
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "tooltip": false
    },

    "clock": {
        "interval": 30,
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b}",
        "tooltip-format": "<big>{:%Y-%m-%d}</big>\n<tt>{calendar}</tt>"
    },

    "wireplumber": {
        "format": "{volume}% {icon}",
        "format-muted": "{volume}% \uf026",
        "format-icons": ["\uf027", "\uf028", "\uf028"],
        "scroll-step": 2,
        "max-volume": 100,
        "tooltip-format": "{node_name}: {volume}%"
    },

    "backlight": {
        "device": "nvidia_wmi_ec_backlight",
        "format": "{percent}% {icon}",
        "format-icons": ["\uf186", "\uf185"],
        "scroll-step": 2,
        "tooltip-format": "Brightness: {percent}%"
    },

    "temperature": {
        "thermal-zone": 0,
        "interval": 10,
        "format": "{temperatureC}\u00b0C",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}\u00b0C",
        "tooltip-format": "{temperatureC}\u00b0C / {temperatureF}\u00b0F"
    },

    "cpu": {
        "interval": 5,
        "format": "CPU {usage}%",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip-format": "CPU load: {load}%"
    },

    "memory": {
        "interval": 5,
        "format": "MEM {percentage}%",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip-format": "Used: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.2f}G"
    },

    "disk": {
        "path": "/",
        "interval": 120,
        "format": "DISK {used} / {total}",
        "tooltip-format": "{path}: {percentage_free}% free"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% \uf0e7",
        "format-plugged": "{capacity}% \uf1e6",
        "format-full": "{capacity}% \uf240",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"]
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    "custom/sep": {
        "format": "|"
    }
}
